{
  "manifest_version": 3,
  "name": "Messenger Share",
  "version": "1.0",
  "description": "Right-click share links, images, and videos to Telegram and Viber via Omarchy",
  "permissions": [
    "contextMenus",
    "nativeMessaging"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background-7.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["twitter-tweet-url.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.instagram.com/*", "https://instagram.com/*"],
      "js": ["instagram-post-url.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.tiktok.com/*", "https://tiktok.com/*"],
      "js": ["tiktok-video-url.js"],
      "run_at": "document_start"
    }
  ],
  "key": "",
  "host_permissions": [
    "<all_urls>"
  ]
}
