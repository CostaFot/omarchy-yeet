{
  "manifest_version": 3,
  "name": "Messenger Share",
  "version": "1.0",
  "description": "Right-click share links, images, and videos to Telegram and Viber via Omarchy",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "downloads",
    "storage"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "key": ""
}
